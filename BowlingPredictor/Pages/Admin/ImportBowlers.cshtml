@page
@model ImportBowlersModel
@{
    ViewData["Title"] = "Import Bowlers";
}

<h2>Import Bowlers (Excel)</h2>

<form method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label for="LeagueId" class="form-label">League</label>
        <select id="LeagueId" name="LeagueId" class="form-select" asp-for="LeagueId">
            @foreach (var league in Model.AvailableLeagues)
            {
                <option value="@league.LeagueId">@league.Name</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label for="Upload" class="form-label">Select Excel File</label>
        <input type="file" id="Upload" class="form-control" asp-for="Upload" accept=".xlsx,.xls" required />
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
</form>

@if (Model.ResultMessage is not null)
{
    <pre>@Model.ResultMessage</pre>
}
