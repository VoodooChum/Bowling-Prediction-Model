@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Bowling Predictor</h1>
    <p>League match tracking and prediction system</p>
</div>

<div class="row mt-5">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Import Bowlers</h5>
                <p class="card-text">Import or update bowler rosters from Excel files.</p>
                <a href="/Admin/ImportBowlers" class="btn btn-primary">Go to Import</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Import Weekly Recaps</h5>
                <p class="card-text">Import match results and scoring data from PDF recaps.</p>
                <a href="/Admin/ImportRecaps" class="btn btn-primary">Go to Import</a>
            </div>
        </div>
    </div>
</div>
